{
  "name": "frontend-inspo-mcp",
  "version": "0.3.0",
  "mcpName": "io.github.notsointresting/frontend-inspo-mcp",
  "description": "Local MCP server that lets AI coding agents discover and pull real frontend code, UI components, and design mockups from shadcn, Magic UI, Aceternity, FreeFrontend, and more.",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "frontend-inspo-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js",
    "test": "npm run build && node --test",
    "coverage": "npm run build && c8 node --test",
    "check:reproducible": "node scripts/check-reproducible.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "pack:mcpb": "npx -y @anthropic-ai/mcpb@2.1.2 pack . frontend-inspo-mcp.mcpb",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "claude",
    "cursor",
    "kiro",
    "frontend",
    "ui-components",
    "shadcn",
    "shadcn-ui",
    "magic-ui",
    "aceternity",
    "tailwindcss",
    "react",
    "threejs",
    "vibe-coding",
    "llm-tools"
  ],
  "author": "notsointresting",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/notsointresting/frontend-inspo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/notsointresting/frontend-inspo-mcp/issues"
  },
  "homepage": "https://github.com/notsointresting/frontend-inspo-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "c8": "12.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
